---
/**
 * Renders a `DocumentBlock` embedded in a Page's Structured Text body: a
 * downloadable PDF shown by its caption (the required `description`, used as the
 * title) with a PDF mark and a download affordance. The raw file name is hidden.
 */
import { type FragmentOf, readFragment } from '~/lib/datocms/graphql';
import { DocumentBlockFragment } from './fragments';

interface Props {
  block: FragmentOf<typeof DocumentBlockFragment>;
}

const { pdfFile, description } = readFragment(DocumentBlockFragment, Astro.props.block);
---

<a class="document-block" href={pdfFile.url} target="_blank" rel="noopener noreferrer" download>
  <svg
    class="document-block__icon"
    viewBox="0 0 32 32"
    width="34"
    height="34"
    role="img"
    aria-label="PDF"
  >
    <path d="M8 2h12l6 6v20a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="#E2493A"></path>
    <path d="M20 2l6 6h-6V2z" fill="#B83227"></path>
    <text
      x="16"
      y="23"
      text-anchor="middle"
      font-family="system-ui, sans-serif"
      font-size="7"
      font-weight="700"
      fill="#fff">PDF</text
    >
  </svg>

  <span class="document-block__label">{description}</span>

  <svg
    class="document-block__download"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
  >
    <path d="M12 3v11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
    ></path>
    <path
      d="M8 11l4 4 4-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path d="M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
    ></path>
  </svg>
</a>

<style>
  .document-block {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.1rem;
    margin: 1rem 0;
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .document-block:hover {
    border-color: color-mix(in srgb, currentColor 35%, transparent);
    background-color: color-mix(in srgb, currentColor 4%, transparent);
  }
  .document-block__icon {
    flex: none;
  }
  .document-block__label {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    line-height: 1.3;
  }
  .document-block__download {
    flex: none;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }
  .document-block:hover .document-block__download {
    color: var(--color-link-strong);
  }
</style>

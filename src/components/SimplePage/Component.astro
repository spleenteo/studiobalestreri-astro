---
/**
 * Generic inner page: a claim-style title + optional incipit + a white content
 * card with the HTML body. Used by the singleton pages (cv, why, …) and as the
 * header for category / premium list pages.
 */
import { RichText } from '~/components/RichText';

interface Props {
  title: string;
  bodyHtml?: string | null;
  incipit?: string | null;
}

const { title, bodyHtml, incipit } = Astro.props;
---

<h1 class="page-title">{title}</h1>

{incipit && <p class="claim__incipit">{incipit}</p>}

<div class="page">
  {bodyHtml ? <RichText html={bodyHtml} /> : null}
  <slot />
</div>

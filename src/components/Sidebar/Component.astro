---
/**
 * Left sidebar: site menu (mobile only), categories and useful links.
 * Desktop: in-flow sticky column. Mobile: off-canvas drawer toggled by the
 * hamburger button (wired in Layout). Data is passed in from the Layout's
 * single chrome query.
 */
import type { MenuItem } from '~/lib/nav';
import { categoryPath } from '~/lib/urls';

interface Props {
  menu: readonly MenuItem[];
  // `label` is the short menu name shown in the sidebar; `name` is the full
  // category name, kept for the truncation tooltip and the accessible name.
  categories: ReadonlyArray<{ name: string; label: string; slug: string }>;
  links: ReadonlyArray<{ name: string; url: string }>;
  premiumSlug: string;
}

const { menu, categories, links, premiumSlug } = Astro.props;
---

<button
  class="sidebar__toggler"
  type="button"
  aria-label="Apri il menu"
  aria-controls="sidebar"
  aria-expanded="false"
>
  ☰
</button>

<aside class="sidebar" id="sidebar">
  <nav class="sidebar__m-menu sidebar__widget" aria-label="Menu">
    <div class="sidebar__widget-title">Studio Balestreri</div>
    <ul>
      {
        menu.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="sidebar__widget">
    <div class="sidebar__widget-title">Categorie</div>
    <ul>
      <li data-full="Tutti"><a href="/articles">Tutti</a></li>
      {
        categories.map((category) => (
          <li data-full={category.name}>
            <a href={categoryPath(category.slug)} aria-label={category.name}>
              {category.label}
            </a>
          </li>
        ))
      }
      <li data-full="Premium"><a href={`/${premiumSlug}`}>Premium</a></li>
    </ul>
  </div>

  {
    links.length > 0 && (
      <div class="sidebar__widget">
        <div class="sidebar__widget-title">Link utili</div>
        <ul>
          {links.map((link) => (
            <li data-full={link.name}>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</aside>

<script>
  // Flag sidebar items whose label is visually truncated, so the CSS tooltip
  // (the full name) appears only when it's actually needed. Categories show the
  // short `label`; the full name stays available via `aria-label`/`data-full`.
  const items = document.querySelectorAll<HTMLLIElement>('#sidebar .sidebar__widget li[data-full]');

  const measure = () => {
    items.forEach((li) => {
      const link = li.querySelector('a');
      if (!link) return;
      li.toggleAttribute('data-truncated', link.scrollWidth - link.clientWidth > 1);
    });
  };

  measure();
  // Re-measure once the web fonts settle (Spectral changes label widths).
  document.fonts?.ready.then(measure);

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener(
    'resize',
    () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(measure, 150);
    },
    { passive: true },
  );
</script>

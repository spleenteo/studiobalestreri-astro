---
/**
 * Renders a DatoCMS external video field (`VideoField`) as a responsive iframe
 * embed (YouTube / Vimeo). Replaces the old `video_url.iframe_embed()`.
 */
interface Props {
  video: {
    url: string;
    provider: string;
    providerUid: string;
    title?: string | null;
    width?: number | null;
    height?: number | null;
  };
}

const { video } = Astro.props;

let src: string | null = null;
if (video.provider === 'youtube') {
  src = `https://www.youtube-nocookie.com/embed/${video.providerUid}`;
} else if (video.provider === 'vimeo') {
  src = `https://player.vimeo.com/video/${video.providerUid}`;
}
---

{
  src ? (
    <div class="video-embed">
      <iframe
        src={src}
        title={video.title ?? 'Video'}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  ) : (
    <a href={video.url} target="_blank" rel="noopener noreferrer">
      {video.title ?? video.url}
    </a>
  )
}

<style>
  .video-embed {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

---
import { type FragmentOf, readFragment } from '~/lib/datocms/graphql';
import { Text } from '~/components/Text';
import { TextBlock } from '~/components/TextBlock';
import { VideoBlock } from '~/components/VideoBlock';
import { ImageBlock } from '~/components/ImageBlock';
import { LinkToArticle } from '~/components/LinkToArticle';
import { LinkToPage } from '~/components/LinkToPage';
import { ShareLinks } from '~/components/ShareLinks';
import { PremiumBadge } from '~/components/PremiumBadge';
import { ArticleViewFragment } from './fragments';

interface Props {
  article: FragmentOf<typeof ArticleViewFragment>;
}

const { article: articleProp } = Astro.props;
const article = readFragment(ArticleViewFragment, articleProp);

const articleDate = new Date(article._firstPublishedAt);
const fmtIt = (opts: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('it-IT', { ...opts, timeZone: 'UTC' }).format(articleDate);
const calMonth = fmtIt({ month: 'long' });
const calDay = fmtIt({ day: 'numeric' });
const calYear = fmtIt({ year: 'numeric' });
const categories = article.categories.map((category) => category.name).join(', ');
const shareUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
---

<article class="page article-detail" data-reveal>
  <time class="article-cal" datetime={article._firstPublishedAt}>
    <span class="article-cal__month">{calMonth}</span>
    <span class="article-cal__day">{calDay}</span>
    <span class="article-cal__year">{calYear}</span>
  </time>

  <div class="article-box__meta">
    <span>{categories}</span>
  </div>

  {article.premium && <PremiumBadge />}

  <h1 class="article-detail__title">{article.title}</h1>

  {
    /*
     * PREMIUM GATE (seam) — see docs/shaping/frontend-shaping.md (R6).
     * Today every article renders in full. To re-enable gating later, this is
     * the single spot to change: if `article.premium` and the request has no
     * authorised premium session (auth-astro / Supabase), render
     * `article.abstract` + a sign-in CTA instead of the body/blocks below.
     */
  }

  <Text
    data={article.content}
    blockComponents={{
      TextBlockRecord: TextBlock,
      VideoBlockRecord: VideoBlock,
      ImageBlockRecord: ImageBlock,
    }}
    linkToRecordComponents={{
      ArticleRecord: LinkToArticle,
      PageRecord: LinkToPage,
    }}
  />

  {
    article.documents.length > 0 && (
      <div class="article-box__doc">
        <h4 class="article-box__doc-title">Documenti disponibili</h4>
        {article.documents.map((document) => (
          <a
            class="article-box__doc-item"
            href={document.doc.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span aria-hidden="true">↓</span>
            <span>{document.title}</span>
          </a>
        ))}
      </div>
    )
  }

  <footer class="article-box__footer">
    <ShareLinks url={shareUrl} title={article.title} />
  </footer>
</article>

<style>
  .article-detail {
    position: relative;
  }

  /* Tear-off calendar chip: month band on top, big day, year below. Sits at the
     top-right and pokes slightly above the card's top border. */
  .article-cal {
    position: absolute;
    top: 0;
    right: clamp(var(--space-3), 4vw, var(--space-5));
    transform: translateY(-52%);
    z-index: 2;
    width: 4.6rem;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--color-paper);
    border: 1px solid var(--color-hairline);
    box-shadow: 0 12px 28px -16px oklch(0.27 0.02 110 / 0.55);
    font-family: var(--font-label);
    text-align: center;
    line-height: 1;
  }
  .article-cal__month {
    display: block;
    padding: 0.34rem 0.2rem;
    background-color: var(--color-link-strong);
    color: var(--color-paper);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .article-cal__day {
    display: block;
    padding: 0.32rem 0 0.04rem;
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .article-cal__year {
    display: block;
    padding-bottom: 0.42rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  .article-detail__title {
    font-size: var(--text-h1);
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }
  .article-detail__image {
    margin-bottom: var(--space-4);
  }
  .article-detail__block {
    margin: var(--space-4) 0;
  }
</style>

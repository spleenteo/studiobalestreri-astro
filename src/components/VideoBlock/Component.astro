---
/**
 * Renders a `VideoBlock` embedded in a Page's Structured Text body. Delegates
 * to the shared `<VideoEmbed />` (YouTube/Vimeo iframe).
 */
import { type FragmentOf, readFragment } from '~/lib/datocms/graphql';
import { VideoEmbed } from '~/components/VideoEmbed';
import { VideoBlockFragment } from './fragments';

interface Props {
  block: FragmentOf<typeof VideoBlockFragment>;
}

const { videoUrl } = readFragment(VideoBlockFragment, Astro.props.block);
---

<VideoEmbed video={videoUrl} />

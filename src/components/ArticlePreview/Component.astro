---
import { type FragmentOf, readFragment } from '~/lib/datocms/graphql';
import { PremiumBadge } from '~/components/PremiumBadge';
import { articlePath } from '~/lib/urls';
import { ArticlePreviewFragment } from './fragments';

interface Props {
  article: FragmentOf<typeof ArticlePreviewFragment>;
}

const { article: articleProp } = Astro.props;
const article = readFragment(ArticlePreviewFragment, articleProp);
const href = articlePath(article);
const dateLabel = new Intl.DateTimeFormat('it-IT', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(article._firstPublishedAt));
---

<a class="hl" href={href}>
  <div class="hl__content">
    <div class="hl__date">
      {dateLabel}
      {article.premium && <PremiumBadge />}
    </div>
    <div class="hl__title">{article.title}</div>
  </div>
</a>

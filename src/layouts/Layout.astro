---
import '~/styles/global.css';

import { Seo, type TitleMetaLinkTag } from '@datocms/astro';
import { ContentLink } from '@datocms/astro/ContentLink';

import { graphql } from '~/lib/datocms/graphql';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { TagFragment } from '~/lib/datocms/commonFragments';
import { isDraftModeEnabled } from '~/lib/draftMode';
import { buildMainMenu } from '~/lib/nav';

import { Header } from '~/components/Header';
import { Sidebar } from '~/components/Sidebar';
import { Footer } from '~/components/Footer';
import { DraftModeToggler } from '~/components/DraftModeToggler';

type Props = {
  additionalSeo?: TitleMetaLinkTag[];
};

const { additionalSeo = [] } = Astro.props;

/**
 * Single "chrome" query: favicon meta + sidebar data (categories, useful links,
 * premium page slug). Runs on every page; cheap and CDN-cached.
 */
const query = graphql(
  /* GraphQL */ `
    query ChromeQuery {
      _site {
        faviconMetaTags {
          ...TagFragment
        }
      }
      allArticleCategories(orderBy: name_ASC) {
        name
        label
        slug
      }
      allLinks(orderBy: position_ASC) {
        name
        url
      }
      allPages(orderBy: position_ASC) {
        title
        slug
      }
      premiumArticlesPage {
        slug
      }
    }
  `,
  [TagFragment],
);

const draftModeEnabled = isDraftModeEnabled(Astro.cookies);
const { _site, allArticleCategories, allLinks, allPages, premiumArticlesPage } = await executeQuery(
  query,
  {
    includeDrafts: draftModeEnabled,
  },
);

const premiumSlug = premiumArticlesPage?.slug ?? 'premium';
const menu = buildMainMenu(allPages);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="ryqku03JkCVZH_yXWlzoscr5m_Y0pXUHAXXYGbfKsZA" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />
    <Seo data={[..._site.faviconMetaTags, ...additionalSeo]} />
  </head>

  <body>
    <a class="skip-link" href="#main">Salta al contenuto</a>

    <Header menu={menu} />

    <div class="shell">
      <Sidebar
        menu={menu}
        categories={allArticleCategories}
        links={allLinks}
        premiumSlug={premiumSlug}
      />
      <main id="main" class="main">
        <slot />
      </main>
    </div>

    <Footer />

    {draftModeEnabled && <ContentLink enableClickToEdit={{ hoverOnly: true }} />}
    <DraftModeToggler />

    <script>
      const toggler = document.querySelector<HTMLButtonElement>('.sidebar__toggler');
      const sidebar = document.getElementById('sidebar');

      toggler?.addEventListener('click', () => {
        const open = sidebar?.classList.toggle('is-open') ?? false;
        toggler.setAttribute('aria-expanded', String(open));
      });

      // Close the drawer when navigating or clicking a link inside it.
      sidebar?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) {
          sidebar.classList.remove('is-open');
          toggler?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>

    <script>
      // Light scroll-reveal. Opt-in via `.has-motion`, which is added only when
      // motion is welcome — so no-JS and reduced-motion visitors never get the
      // hidden start state.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const wantsMotion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (revealables.length && wantsMotion && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('has-motion');
        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
        );
        revealables.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

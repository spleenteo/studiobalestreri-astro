---
import Layout from '~/layouts/Layout.astro';
import { graphql } from '~/lib/datocms/graphql';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { TagFragment } from '~/lib/datocms/commonFragments';
import { isDraftModeEnabled } from '~/lib/draftMode';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { SimplePage } from '~/components/SimplePage';

const query = graphql(
  /* GraphQL */ `
    query ContactsQuery {
      contacts {
        _seoMetaTags {
          ...TagFragment
        }
        title
        body(markdown: true)
        map {
          latitude
          longitude
        }
      }
    }
  `,
  [TagFragment],
);

const draftModeEnabled = isDraftModeEnabled(Astro.cookies);
const { contacts } = await executeQuery(query, { includeDrafts: draftModeEnabled });

if (!contacts) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const mapSrc = contacts.map
  ? `https://maps.google.com/maps?q=${contacts.map.latitude},${contacts.map.longitude}&z=15&output=embed`
  : null;
---

<Layout additionalSeo={contacts._seoMetaTags}>
  <SimplePage title={contacts.title} bodyHtml={contacts.body}>
    {
      mapSrc && (
        <iframe
          class="contacts-map"
          src={mapSrc}
          title="Mappa"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      )
    }
  </SimplePage>
  <DraftModeQueryListener query={query} />
</Layout>

<style is:global>
  .contacts-map {
    width: 100%;
    height: 360px;
    border: 0;
    margin-top: var(--space-3);
  }
</style>

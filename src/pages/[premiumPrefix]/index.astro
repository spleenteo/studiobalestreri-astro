---
import Layout from '~/layouts/Layout.astro';
import { graphql } from '~/lib/datocms/graphql';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { TagFragment } from '~/lib/datocms/commonFragments';
import { isDraftModeEnabled } from '~/lib/draftMode';
import { RichText } from '~/components/RichText';
import { ArticleBox, ArticleBoxFragment } from '~/components/ArticleBox';

/**
 * Premium articles listing at `/{premiumSlug}` (e.g. `/premium`). The dynamic
 * segment is validated against the premium page's slug so this route only
 * answers the real premium URL (everything else 404s; static pages like /cv
 * win by route priority).
 */
const { premiumPrefix = '' } = Astro.params;
const draftModeEnabled = isDraftModeEnabled(Astro.cookies);

const query = graphql(
  /* GraphQL */ `
    query PremiumListQuery {
      premiumArticlesPage {
        slug
        title
        description(markdown: true)
        _seoMetaTags {
          ...TagFragment
        }
      }
      allArticles(orderBy: _firstPublishedAt_DESC, filter: { premium: { eq: true } }) {
        ...ArticleBoxFragment
      }
    }
  `,
  [TagFragment, ArticleBoxFragment],
);

const { premiumArticlesPage, allArticles } = await executeQuery(query, {
  includeDrafts: draftModeEnabled,
});

if (!premiumArticlesPage || premiumPrefix !== premiumArticlesPage.slug) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const premiumSlug = premiumArticlesPage.slug;
---

<Layout additionalSeo={premiumArticlesPage._seoMetaTags}>
  <h1 class="page-title">{premiumArticlesPage.title}</h1>
  {
    premiumArticlesPage.description && (
      <div class="claim__incipit">
        <RichText html={premiumArticlesPage.description} />
      </div>
    )
  }

  <div class="page">
    {allArticles.map((article) => <ArticleBox article={article} premiumSlug={premiumSlug} />)}
  </div>
</Layout>

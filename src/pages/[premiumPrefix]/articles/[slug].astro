---
import Layout from '~/layouts/Layout.astro';
import { readFragment } from '~/lib/datocms/graphql';
import { isDraftModeEnabled } from '~/lib/draftMode';
import { articleQuery, fetchArticle } from '~/lib/articles';
import { ArticleView, ArticleViewFragment } from '~/components/ArticleView';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';

/**
 * Premium article detail at `/{premiumSlug}/articles/{slug}`. Validates the
 * prefix and that the article is actually premium (otherwise redirects to its
 * non-premium canonical URL). Content is currently open — see the PREMIUM GATE
 * seam in ArticleView.
 */
const { premiumPrefix = '', slug = '' } = Astro.params;
const draftModeEnabled = isDraftModeEnabled(Astro.cookies);

const { article, premiumSlug } = await fetchArticle(slug, draftModeEnabled);

if (!article || premiumPrefix !== premiumSlug) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const unmasked = readFragment(ArticleViewFragment, article);

// A non-premium article is canonical at `/articles/{slug}`.
if (!unmasked.premium) {
  return Astro.redirect(`/articles/${unmasked.slug}`, 301);
}
---

<Layout additionalSeo={unmasked._seoMetaTags}>
  <ArticleView article={article} />
  <DraftModeQueryListener query={articleQuery} variables={{ slug }} />
</Layout>
